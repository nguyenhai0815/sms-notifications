<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmsNotifications" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorOnPrimary">@color/header_ink</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:windowBackground">@color/screen</item>
        <item name="android:statusBarColor">@color/header</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>

    <style name="Theme.SmsNotifications.Plain">
        <item name="android:statusBarColor">@color/card</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Nut vien nhat tren nen trang, dung o thanh cong cu va dong nut -->
    <style name="Widget.Relay.Button.Tonal" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/card</item>
        <item name="android:textColor">@color/ink</item>
        <item name="iconTint">@color/ink</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">18dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Relay.Button.Solid" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/header_ink</item>
        <item name="iconTint">@color/header_ink</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">18dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Relay.HeaderIcon" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:tint">@color/header_muted</item>
    </style>

    <style name="Widget.Relay.SectionTitle" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="Widget.Relay.Field" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="hintTextColor">@color/primary</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>
</resources>
